+.dp-merchant-shell {
+  width: min(calc(100% - 32px), var(--dp-page-max));
+  margin: 0 auto;
+  padding: 32px 0 56px;
+}
+
+.dp-merchant-panel {
+  width: 100%;
+  padding: 32px;
+}
+
+.dp-merchant-header {
+  display: grid;
+  grid-template-columns: 110px minmax(0, 1fr) minmax(180px, auto);
+  gap: 24px;
+  align-items: center;
+  margin-bottom: 24px;
+}
+
+.dp-merchant-avatar {
+  width: 110px;
+  height: 110px;
+  display: flex;
+  align-items: center;
