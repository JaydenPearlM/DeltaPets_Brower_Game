+  border: 2px solid var(--merchant-gold);
+  border-radius: 16px;
+  background: var(--merchant-dark-wood);
+  color: var(--merchant-cream);
+  font-family: var(--font-heading);
+  font-size: 0.76rem;
+  letter-spacing: 0.06em;
+  text-align: center;
+  text-transform: uppercase;
+}
+
+.dp-merchant-heading {
+  min-width: 0;
+}
+
+.dp-merchant-name {
+  margin: 0;
+  font-family: var(--font-heading);
+  font-size: clamp(1.45rem, 2.4vw, 2.2rem);
+  color: var(--merchant-gold);
+}
+
+.dp-merchant-shop-name {
+  margin: 6px 0 0;
+  color: var(--merchant-cream);
+}
+
+.dp-merchant-wallets {
+  display: grid;
+  gap: 10px;
+}
+
+.dp-merchant-wallet {
+  min-width: 180px;
+  padding: 12px 16px;
+  border: 1px solid var(--merchant-gold);
+  border-radius: 12px;
+  background: var(--merchant-shadow);
+  text-align: right;
+}
+
+.dp-merchant-wallet-label {
+  display: block;
+  margin-bottom: 4px;
+  font-size: 0.7rem;
+  font-weight: 900;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.dp-merchant-wallet-value {
+  display: block;
+  font-family: var(--font-heading);
+  font-size: 1.05rem;
+  color: var(--merchant-gold);
+}
+
+.dp-merchant-content {
+  display: grid;
+  grid-template-columns: minmax(0, 1.65fr) minmax(320px, 0.85fr);
+  gap: 24px;
+  align-items: stretch;
+}
+
+.dp-merchant-section {
+  min-width: 0;
+  padding: 22px;
+  border: 1px solid var(--merchant-fabric);
+  border-radius: 16px;
+  background: var(--merchant-shadow);
+}
+
+.dp-merchant-section-title {
+  margin: 0 0 18px;
+  font-family: var(--font-heading);
+  font-size: 0.95rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--merchant-gold);
+}
+
+.dp-merchant-item-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 16px;
+}
+
+.dp-merchant-item {
+  min-height: 154px;
+  padding: 18px;
+  border: 1px solid var(--merchant-fabric);
+  border-radius: 12px;
+  background: var(--merchant-wall);
+}
+
+.dp-merchant-item-name {
+  margin: 0;
+  font-family: var(--font-heading);
+  color: var(--merchant-cream);
+}
+
+.dp-merchant-item-copy {
+  margin: 10px 0 0;
+  line-height: 1.5;
+  color: var(--merchant-cream);
+}
+
+.dp-merchant-item-price {
+  margin: 16px 0 0;
+  font-family: var(--font-heading);
