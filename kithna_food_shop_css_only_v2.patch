+  justify-content: center;
+  padding: 24px;
+  border: 2px solid var(--merchant-gold);
+  border-radius: 16px;
+  background: var(--merchant-dark-wood);
+  color: var(--merchant-cream);
+  font-family: var(--font-heading);
+  letter-spacing: 0.06em;
+  text-align: center;
+  text-transform: uppercase;
+}
+
+.dp-merchant-dialogue {
+  margin: 0;
+  padding: 16px 18px;
+  border: 1px solid var(--merchant-fabric);
+  border-radius: 12px;
+  background: var(--merchant-wall);
+  line-height: 1.55;
+}
+
+.dp-merchant-daily {
+  padding: 16px 18px;
+  border: 1px solid var(--merchant-gold);
+  border-radius: 12px;
+  background: var(--merchant-wall);
+}
+
+.dp-merchant-daily-title {
+  margin: 0 0 8px;
+  font-family: var(--font-heading);
+  color: var(--merchant-gold);
+}
+
+.dp-merchant-daily-copy {
+  margin: 0;
+  line-height: 1.5;
+}
+
+.dp-merchant-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 12px;
+  margin-top: 24px;
+}
+
+.dp-merchant-actions .dp-btn {
+  min-width: 150px;
+}
+
+@media (max-width: 980px) {
+  .dp-merchant-header {
+    grid-template-columns: 96px minmax(0, 1fr);
+  }
+
+  .dp-merchant-avatar {
+    width: 96px;
+    height: 96px;
+  }
+
+  .dp-merchant-wallets {
+    grid-column: 1 / -1;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .dp-merchant-wallet {
+    min-width: 0;
+    text-align: left;
+  }
+
+  .dp-merchant-content {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 640px) {
+  .dp-merchant-shell {
+    width: min(calc(100% - 20px), var(--dp-page-max));
+    padding: 20px 0 40px;
+  }
+
+  .dp-merchant-panel {
+    padding: 22px 16px;
+  }
+
+  .dp-merchant-header,
+  .dp-merchant-wallets,
+  .dp-merchant-item-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .dp-merchant-header {
+    text-align: center;
+  }
+
+  .dp-merchant-avatar {
+    margin: 0 auto;
+  }
+
+  .dp-merchant-wallet {
+    text-align: center;
+  }
+
+  .dp-merchant-foreground {
+    min-height: 260px;
+  }
+
+  .dp-merchant-actions {
+    flex-direction: column;
+  }
+
+  .dp-merchant-actions .dp-btn {
+    width: 100%;
+  }
+}
+
