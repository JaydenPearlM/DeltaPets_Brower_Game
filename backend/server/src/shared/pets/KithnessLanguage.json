{
  "language_id": "kithness",
  "display_name": "Kithness",
  "version": "1.0",

  "inspiration": {
    "primary": [
      "latin_phonetics",
      "soft_creature_speech",
      "repeated_syllables",
      "chirps",
      "vowel_harmony"
    ],
    "notes": [
      "Kithness is an original constructed language.",
      "Words are designed to feel ancient, soft, expressive, and creature-like.",
      "Latin-inspired roots are altered heavily to avoid direct one-to-one vocabulary copying.",
      "Short emotional syllables are common.",
      "Repeated syllables often intensify emotion."
    ]
  },

  "phonology": {
    "preferred_vowels": ["a", "e", "i", "o", "u"],

    "preferred_consonants": [
      "m",
      "n",
      "v",
      "l",
      "r",
      "s",
      "t",
      "k",
      "p",
      "f",
      "h",
      "y"
    ],

    "soft_consonants": ["m", "n", "v", "l", "s", "f", "y"],

    "sharp_consonants": ["k", "t", "r", "p"],

    "common_syllable_shapes": ["CV", "CVC", "CVV", "VC", "CVCV"],

    "common_endings": [
      "a",
      "i",
      "o",
      "u",
      "en",
      "is",
      "um",
      "ai",
      "ara",
      "iri",
      "ulo"
    ],

    "common_repetitions": [
      "ki-ki",
      "mi-mi",
      "va-va",
      "lu-lu",
      "na-na",
      "ri-ri",
      "tu-tu",
      "si-si"
    ],

    "emotional_particles": [
      "ki",
      "rii",
      "mm",
      "vaa",
      "tch",
      "hii",
      "nu",
      "rr",
      "pah",
      "mii"
    ]
  },

  "grammar": {
    "default_word_order": "subject_object_verb",

    "subject_optional": true,

    "plural_method": "reduplication_or_suffix",

    "intensifier_method": "repetition",

    "question_marker": "ne",

    "negation_marker": "kai",

    "request_marker": "va",

    "affection_marker": "mira",

    "urgency_marker": "ta",

    "uncertainty_marker": "li",

    "agreement_marker": "ya",

    "softener_marker": "mi",

    "possessive_marker": "na",

    "past_marker": "te",

    "future_marker": "ru",

    "continuing_action_marker": "sa",

    "sentence_endings": {
      "neutral": "a",
      "question": "ne",
      "happy": "ii",
      "sad": "uu",
      "angry": "ka",
      "sleepy": "mm"
    }
  },

  "morphology": {
    "noun_suffixes": ["um", "en", "or", "is"],

    "verb_suffixes": ["a", "i", "ir", "en"],

    "adjective_suffixes": ["al", "in", "ar", "is"],

    "small_or_affectionate_suffixes": ["li", "mi", "ki"],

    "large_or_intense_suffixes": ["ra", "tor", "va"],

    "plural_suffixes": ["i", "ae", "um"],

    "reduplication_rules": {
      "full_repetition": "strong_emphasis",
      "first_syllable_repetition": "playful_or_excited",
      "last_syllable_repetition": "pleading_or_nervous"
    }
  },

  "pronouns": {
    "first_person": {
      "singular": "mi",
      "plural": "mirae"
    },

    "second_person": {
      "singular": "ti",
      "plural": "tirae"
    },

    "third_person": {
      "singular": "si",
      "plural": "sirae"
    },

    "neutral_creature": "ki",

    "bonded_person": "miran"
  },

