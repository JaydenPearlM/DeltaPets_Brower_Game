  "sentence_templates": {
    "request": [
      "{subject} {object} va {verb} ne",
      "{object} va ne",
      "mi {object} vara ne"
    ],

    "refusal": ["kai {object}", "kai. kai.", "{object} kai-ka"],

    "happy_response": ["{emotion} ii", "{object} boni ii", "mira {object} ii"],

    "complaint": ["{need} ta", "{need} rr", "mi {need} nedi ka"],

    "question": ["qua {object} ne", "{object} ne", "ubi {object} ne"],

    "affection": ["mira ti", "ti miran", "mira mira ii"],

    "fear": ["hii {object}", "{object} peri ta", "mi tima ka"],

    "sleepy": ["mi somi mm", "somi va mm", "nesti... mumu..."]
  },

